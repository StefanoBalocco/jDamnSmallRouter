{
  "name": "@stefanobalocco/jdamnsmallmrouter",
  "description": "Damn small hash router",
  "version": "3.0.0",
  "type": "module",
  "types": "dist/jDamnSmallRouter.d.ts",
  "exports": {
    ".": {
      "types": "./dist/jDamnSmallRouter.d.ts",
      "default": "./dist/jDamnSmallRouter.min.js"
    }
  },
  "files": [
    "dist/jDamnSmallRouter.js",
    "dist/jDamnSmallRouter.min.js",
    "dist/jDamnSmallRouter.d.ts"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/StefanoBalocco/jDamnSmallRouter.git"
  },
  "keywords": [
    "hash router",
    "client-side router",
    "spa router"
  ],
  "author": "Stefano Balocco <stefano.balocco@gmail.com>",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/StefanoBalocco/jDamnSmallRouter/issues"
  },
  "homepage": "https://github.com/StefanoBalocco/jDamnSmallRouter",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsBuild all",
    "build:library": "tsBuild library",
    "build:tests": "tsBuild tests",
    "tests": "c8 --include=src --include=dist --exclude-after-remap --per-file --reporter=text --reporter=lcov ava --serial 'tests/dist/*.test.js' --verbose"
  },
  "devDependencies": {
    "@stefanobalocco/tsbuild": "^1",
    "@types/jsdom": "^28",
    "ava": "^8",
    "c8": "^12",
    "jsdom": "^28"
  }
}
